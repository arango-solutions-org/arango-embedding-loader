# --- ArangoDB (server-side default connection; GUI/API can override per request) ---
ARANGO_ENDPOINT=http://localhost:8530
ARANGO_DATABASE=_system
ARANGO_USERNAME=root
ARANGO_PASSWORD=changeme
ARANGO_VERIFY_SSL=true
# Set to false to forbid X-Arango-* header overrides
ALLOW_CONNECTION_OVERRIDE=true

# docker compose host ports
ARANGO_HOST_PORT=8530
APP_HOST_PORT=8000
# Python extras baked into the Docker image (local = sentence-transformers, hosted = SaaS SDKs)
APP_EXTRAS=local,hosted

# --- Embedding providers (only the ones you use) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:8080/v1    # any OpenAI-compatible server (vLLM, TEI, ...)
VOYAGE_API_KEY=
COHERE_API_KEY=
# AWS_REGION=us-east-1                        # Bedrock uses the standard AWS credential chain
# OLLAMA_HOST=http://localhost:11434
# ST_DEVICE=cpu                               # cpu | cuda | mps for sentence-transformers
# HF_HOME=~/.cache/huggingface

# --- Server ---
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=1024
EMBED_CONCURRENCY=4
DEFAULT_BATCH_SIZE=64
# URL_ALLOWED_HOSTS=["storage.googleapis.com"]  # restrict POST /load/url (empty = any host)
# PRESETS_FILE=./presets.yaml
